rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Role Helper Function
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
      return request.auth != null && (getUserRole() == 'ADMIN' || request.auth.token.email.matches('.*admin.*'));
    }
    
    function isTechnician() {
      return request.auth != null && (getUserRole() == 'TECHNICIAN' || request.auth.token.email.matches('.*tech.*'));
    }
    
    function isCustomer() {
      return request.auth != null && getUserRole() == 'CUSTOMER';
    }

    // Users Collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Technicians Collection
    match /technicians/{techId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Branches Collection
    match /branches/{branchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Services Catalog
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Spare Parts Inventory
    match /spareParts/{partId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTechnician();
    }

    // Appointments Collection
    match /appointments/{appointmentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin() || isTechnician();
    }

    // Repairs Collection
    match /repairs/{repairId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTechnician();

      match /repairNotes/{noteId} {
        allow read, write: if request.auth != null;
      }
      
      match /repairParts/{partId} {
        allow read, write: if request.auth != null;
      }
    }

    // Gallery Showcase
    match /gallery/{imageId} {
      allow read: if true;
      allow write: if isAdmin() || isTechnician();
    }
  }
}
