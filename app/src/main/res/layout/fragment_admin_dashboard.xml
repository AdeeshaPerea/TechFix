<!--  Screen: Admin Dashboard (Home tab)  -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/techfix_bg">
<!--  ===== Header =====  -->
<LinearLayout android:id="@+id/header" android:layout_width="0dp" android:layout_height="wrap_content" android:background="@color/techfix_navy" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="28dp" android:paddingBottom="24dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<TextView android:id="@+id/tvDashboardTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="📊 Admin Dashboard" android:textColor="@color/techfix_white" android:textSize="22sp" android:textStyle="bold"/>
<ImageButton android:id="@+id/btnSettings" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_button_navy" android:contentDescription="Settings" android:src="@android:drawable/ic_menu_manage" app:tint="@color/techfix_white"/>
</LinearLayout>
<TextView android:id="@+id/tvDashboardSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Colombo &amp; Galle · Today, 27 Jul" android:textColor="#C9CFDA" android:textSize="15sp"/>
</LinearLayout>
<!--  ===== Scrollable content =====  -->
<androidx.core.widget.NestedScrollView android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintTop_toBottomOf="@id/header" app:layout_constraintBottom_toTopOf="@id/bottomNav" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<!--  Stat cards: 2x2 grid  -->
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp" app:cardBackgroundColor="@color/techfix_navy" app:cardCornerRadius="16dp" app:cardElevation="0dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="20dp">
<TextView android:id="@+id/tvTotalRepairs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="42" android:textColor="@color/techfix_white" android:textSize="24sp" android:textStyle="bold"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Total Repairs" android:textColor="#C9CFDA" android:textSize="13sp"/>
</LinearLayout>
</androidx.cardview.widget.CardView>
<androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" app:cardBackgroundColor="@color/techfix_white" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/techfix_light_gray">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="20dp">
<TextView android:id="@+id/tvPendingAppointments" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7" android:textColor="@color/techfix_navy" android:textSize="24sp" android:textStyle="bold"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Pending Appts." android:textColor="@color/techfix_gray_text" android:textSize="13sp"/>
</LinearLayout>
</androidx.cardview.widget.CardView>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
<androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp" app:cardBackgroundColor="@color/techfix_white" app:cardCornerRadius="16dp" app:cardElevation="0dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="20dp">
<TextView android:id="@+id/tvActiveRepairs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12" android:textColor="@color/techfix_navy" android:textSize="24sp" android:textStyle="bold"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Active Repairs" android:textColor="@color/techfix_gray_text" android:textSize="13sp"/>
</LinearLayout>
</androidx.cardview.widget.CardView>
<androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" app:cardBackgroundColor="@color/techfix_white" app:cardCornerRadius="16dp" app:cardElevation="0dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="20dp">
<TextView android:id="@+id/tvCompletedRepairs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="23" android:textColor="@color/techfix_navy" android:textSize="24sp" android:textStyle="bold"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Completed Repairs" android:textColor="@color/techfix_gray_text" android:textSize="13sp"/>
</LinearLayout>
</androidx.cardview.widget.CardView>
</LinearLayout>
<!--  Low Stock Alerts  -->
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:layout_marginBottom="12dp" android:gravity="center" android:text="Low Stock Alerts" android:textColor="@color/techfix_navy" android:textSize="18sp" android:textStyle="bold"/>
<!--  NOTE: replace this LinearLayout of static cards with a
                 RecyclerView (id: rvLowStock) bound to a LowStockAdapter
                 once wired up to Firestore/SQLite spare-parts data.  -->
<LinearLayout android:id="@+id/lowStockContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:cardBackgroundColor="@color/techfix_white" app:cardCornerRadius="16dp" app:cardElevation="0dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="18dp">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="OLED Panel — iPhone 12" android:textColor="@color/techfix_navy" android:textSize="16sp" android:textStyle="bold"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_red" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:text="2 LEFT" android:textColor="@color/techfix_red" android:textSize="12sp" android:textStyle="bold"/>
</LinearLayout>
</androidx.cardview.widget.CardView>
<androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/techfix_white" app:cardCornerRadius="16dp" app:cardElevation="0dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="18dp">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Battery — Galaxy A54" android:textColor="@color/techfix_navy" android:textSize="16sp" android:textStyle="bold"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_red" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:text="3 LEFT" android:textColor="@color/techfix_red" android:textSize="12sp" android:textStyle="bold"/>
</LinearLayout>
</androidx.cardview.widget.CardView>
</LinearLayout>
</LinearLayout>
</androidx.core.widget.NestedScrollView>
<!--  ===== Bottom navigation =====  -->
<com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottomNav" android:layout_width="0dp" android:layout_height="wrap_content" android:background="@color/techfix_white" app:itemIconTint="@color/nav_item_color_selector" app:itemTextColor="@color/nav_item_color_selector" app:menu="@menu/menu_admin_bottom_nav" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
