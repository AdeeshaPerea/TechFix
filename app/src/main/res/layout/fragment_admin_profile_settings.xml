<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android" 
    xmlns:app="http://schemas.android.com/apk/res-auto" 
    android:layout_width="match_parent" 
    android:layout_height="match_parent" 
    android:background="@color/techfix_bg">

    <!-- Header -->
    <LinearLayout 
        android:id="@+id/header" 
        android:layout_width="0dp" 
        android:layout_height="wrap_content" 
        android:background="@color/techfix_navy" 
        android:orientation="vertical" 
        android:paddingTop="24dp" 
        android:paddingBottom="24dp" 
        app:layout_constraintTop_toTopOf="parent" 
        app:layout_constraintStart_toStartOf="parent" 
        app:layout_constraintEnd_toEndOf="parent">

        <TextView 
            android:layout_width="match_parent" 
            android:layout_height="wrap_content" 
            android:gravity="center" 
            android:text="ADMIN SETTINGS" 
            android:textColor="@color/techfix_white" 
            android:textSize="22sp" 
            android:textStyle="bold" 
            android:letterSpacing="0.03"/>
    </LinearLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView 
        android:layout_width="0dp" 
        android:layout_height="0dp" 
        app:layout_constraintTop_toBottomOf="@id/header" 
        app:layout_constraintBottom_toBottomOf="parent" 
        app:layout_constraintStart_toStartOf="parent" 
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout 
            android:layout_width="match_parent" 
            android:layout_height="wrap_content" 
            android:orientation="vertical" 
            android:padding="20dp">

            <!-- Avatar & Profile Info -->
            <TextView 
                android:id="@+id/tvAvatarInitials"
                android:layout_width="96dp" 
                android:layout_height="96dp" 
                android:layout_gravity="center_horizontal" 
                android:layout_marginTop="14dp" 
                android:background="@drawable/bg_avatar_navy" 
                android:gravity="center" 
                android:text="NJ" 
                android:textColor="@color/techfix_white" 
                android:textSize="30sp" 
                android:textStyle="bold"/>

            <TextView 
                android:id="@+id/tvAdminName"
                android:layout_width="match_parent" 
                android:layout_height="wrap_content" 
                android:layout_marginTop="14dp" 
                android:gravity="center" 
                android:text="Nimal Jayasinghe" 
                android:textColor="@color/techfix_dark_text" 
                android:textSize="20sp" 
                android:textStyle="bold"/>

            <TextView 
                android:id="@+id/tvAdminRole"
                android:layout_width="match_parent" 
                android:layout_height="wrap_content" 
                android:layout_marginBottom="24dp" 
                android:gravity="center" 
                android:text="Branch Manager · TechFix Colombo 03" 
                android:textColor="@color/techfix_gray_text" 
                android:textSize="15sp"/>

            <!-- ACCOUNT SECTION -->
            <TextView 
                android:layout_width="match_parent" 
                android:layout_height="wrap_content" 
                android:layout_marginBottom="10dp" 
                android:text="ACCOUNT" 
                android:textColor="@color/techfix_gray_text" 
                android:textSize="13sp" 
                android:textStyle="bold" 
                android:letterSpacing="0.05"/>

            <!-- Edit Profile -->
            <androidx.cardview.widget.CardView 
                android:id="@+id/cardEditProfile"
                android:layout_width="match_parent" 
                android:layout_height="wrap_content" 
                android:layout_marginBottom="10dp" 
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="@color/techfix_white" 
                app:cardCornerRadius="14dp" 
                app:cardElevation="0dp">

                <LinearLayout 
                    android:layout_width="match_parent" 
                    android:layout_height="wrap_content" 
                    android:gravity="center_vertical" 
                    android:orientation="horizontal" 
                    android:padding="18dp">

                    <TextView 
                        android:layout_width="0dp" 
                        android:layout_height="wrap_content" 
                        android:layout_weight="1" 
                        android:text="Edit Profile" 
                        android:textColor="@color/techfix_dark_text" 
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView 
                        android:layout_width="wrap_content" 
                        android:layout_height="wrap_content" 
                        android:text="›" 
                        android:textColor="@color/techfix_gray_text" 
                        android:textSize="20sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Change Password -->
            <androidx.cardview.widget.CardView 
                android:id="@+id/cardChangePassword"
                android:layout_width="match_parent" 
                android:layout_height="wrap_content" 
                android:layout_marginBottom="24dp" 
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="@color/techfix_white" 
                app:cardCornerRadius="14dp" 
                app:cardElevation="0dp">

                <LinearLayout 
                    android:layout_width="match_parent" 
                    android:layout_height="wrap_content" 
                    android:gravity="center_vertical" 
                    android:orientation="horizontal" 
                    android:padding="18dp">

                    <TextView 
                        android:layout_width="0dp" 
                        android:layout_height="wrap_content" 
                        android:layout_weight="1" 
                        android:text="Change Password" 
                        android:textColor="@color/techfix_dark_text" 
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView 
                        android:layout_width="wrap_content" 
                        android:layout_height="wrap_content" 
                        android:text="›" 
                        android:textColor="@color/techfix_gray_text" 
                        android:textSize="20sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- APP PREFERENCES SECTION -->
            <TextView 
                android:layout_width="match_parent" 
                android:layout_height="wrap_content" 
                android:layout_marginBottom="10dp" 
                android:text="APP PREFERENCES" 
                android:textColor="@color/techfix_gray_text" 
                android:textSize="13sp" 
                android:textStyle="bold" 
                android:letterSpacing="0.05"/>

            <!-- Dark Mode Toggle -->
            <androidx.cardview.widget.CardView 
                android:layout_width="match_parent" 
                android:layout_height="wrap_content" 
                android:layout_marginBottom="28dp" 
                app:cardBackgroundColor="@color/techfix_white" 
                app:cardCornerRadius="14dp" 
                app:cardElevation="0dp">

                <LinearLayout 
                    android:layout_width="match_parent" 
                    android:layout_height="wrap_content" 
                    android:gravity="center_vertical" 
                    android:orientation="horizontal" 
                    android:padding="18dp">

                    <TextView 
                        android:layout_width="0dp" 
                        android:layout_height="wrap_content" 
                        android:layout_weight="1" 
                        android:text="Dark Mode" 
                        android:textColor="@color/techfix_dark_text" 
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchDarkMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/techfix_orange"
                        app:trackTint="#FED7AA"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Log Out Button -->
            <Button 
                android:id="@+id/btnLogOut" 
                android:layout_width="match_parent" 
                android:layout_height="56dp" 
                android:background="@drawable/bg_button_outline_orange" 
                android:text="LOG OUT" 
                android:textAllCaps="true" 
                android:textColor="@color/techfix_orange" 
                android:textSize="16sp" 
                android:textStyle="bold"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
