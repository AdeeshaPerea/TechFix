<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1.2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvBranchName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/tvBranchStatsBadge"
                android:layout_marginEnd="8dp"
                android:text="TechFix Colombo"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/tvBranchStatsBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="8 Techs • 15 Repairs"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#1E40AF"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="#DBEAFE"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvBranchAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="📍 142 Galle Road, Colombo 03"
            android:textSize="13sp"
            android:textColor="#64748B" />

        <TextView
            android:id="@+id/tvBranchContactAndHours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="📞 +94 11 234 5678  •  🕒 08:00 AM - 07:00 PM"
            android:textSize="12sp"
            android:textColor="#94A3B8" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
