<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#122040" android:padding="24dp">
<!--  Spacer  -->
<View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
<!--  App Icon  -->
<ImageView android:id="@+id/imgLogo" android:layout_width="90dp" android:layout_height="90dp" android:layout_gravity="center_horizontal" android:background="#F5A623" android:padding="20dp" android:src="@drawable/ic_wrench" android:contentDescription="TechFix logo"/>
<TextView android:id="@+id/txtAppName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:text="TECHFIX" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold"/>
<TextView android:id="@+id/txtSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:text="Technician Portal" android:textColor="#AEB6C4" android:textSize="16sp"/>
<!--  Staff ID / Email  -->
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="40dp" android:layout_gravity="center_horizontal" android:text="STAFF EMAIL / ID" android:textColor="#AEB6C4" android:textStyle="bold" android:textSize="12sp" android:letterSpacing="0.1"/>
<EditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@drawable/bg_input_rounded" android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="center" android:text="tech@techfix.com" android:textColor="#122040" android:textSize="16sp" android:inputType="textEmailAddress"/>
<!--  Password  -->
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_gravity="center_horizontal" android:text="PASSWORD" android:textColor="#AEB6C4" android:textStyle="bold" android:textSize="12sp" android:letterSpacing="0.1"/>
<EditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@drawable/bg_input_rounded" android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="center" android:inputType="textPassword" android:text="123456" android:textColor="#122040" android:textSize="16sp"/>
<TextView android:id="@+id/tvForgotPassword" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_gravity="end" android:text="Forgot Password?" android:textColor="#F5A623" android:textSize="13sp"/>
<!--  Log In Button  -->
<Button android:id="@+id/btnLogin" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp" android:background="@drawable/bg_button_orange" android:text="LOG IN" android:textColor="#FFFFFF" android:textStyle="bold" android:textAllCaps="true" android:letterSpacing="0.05"/>
<TextView android:id="@+id/tvSwitchRole" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:text="← Back to Role Selection" android:textColor="#AEB6C4" android:textSize="13sp"/>
<View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
