<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/divider_color"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/card_bg">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/tvCategoryTag"
            android:layout_marginEnd="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvServiceTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Screen Replacement"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/navy_header" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvServicePrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rs. 8,500"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvEstDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" · 32 min avg."
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <TextView android:id="@+id/tvServiceDesc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCategoryTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Edit"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/badge_blue_text"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp" />
    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>
