<!--  Screen: Appointment Management (Repairs tab)  -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/techfix_bg">
<!--  ===== Header =====  -->
<LinearLayout android:id="@+id/header" android:layout_width="0dp" android:layout_height="wrap_content" android:background="@color/techfix_navy" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="20dp" android:paddingBottom="24dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
<RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:layout_centerVertical="true" android:padding="8dp" android:text="←" android:textColor="@color/techfix_white" android:textSize="22sp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" android:text="Appointments" android:textColor="@color/techfix_white" android:textSize="22sp" android:textStyle="bold"/>
</RelativeLayout>
<TextView android:id="@+id/tvSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="7 awaiting review" android:textColor="#C9CFDA" android:textSize="15sp"/>
</LinearLayout>
<!--  ===== Scrollable content =====  -->
<androidx.core.widget.NestedScrollView android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintTop_toBottomOf="@id/header" app:layout_constraintBottom_toTopOf="@id/bottomNav" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<!--  NOTE: this whole card represents ONE pending appointment item.
                 In production, wrap the "Accept/Reject" block in a RecyclerView
                 (id: rvPendingAppointments) so the list scrolls through all 7,
                 and move Assign Technician / Assign Branch / Confirm into an
                 expandable detail view shown after "Accept" is tapped.  -->
<androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp" app:cardBackgroundColor="@color/techfix_white" app:cardCornerRadius="18dp" app:cardElevation="0dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Water Damage Fix" android:textColor="@color/techfix_navy" android:textSize="20sp" android:textStyle="bold"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_amber" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:text="NEW" android:textColor="@color/techfix_orange" android:textSize="12sp" android:textStyle="bold"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Dilani Fernando · Colombo 03" android:textColor="@color/techfix_gray_text" android:textSize="15sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Requested: 27 Jul, 1:00 PM" android:textColor="@color/techfix_gray_text" android:textSize="15sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
<Button android:id="@+id/btnAccept" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginEnd="10dp" android:background="@drawable/bg_button_orange" android:text="Accept" android:textAllCaps="false" android:textColor="@color/techfix_white" android:textSize="16sp" android:textStyle="bold"/>
<Button android:id="@+id/btnReject" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:background="@drawable/bg_field_outline" android:text="Reject" android:textAllCaps="false" android:textColor="@color/techfix_navy" android:textSize="16sp" android:textStyle="bold"/>
</LinearLayout>
</LinearLayout>
</androidx.cardview.widget.CardView>
<!--  Assign Technician  -->
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="ASSIGN TECHNICIAN" android:textColor="@color/techfix_gray_text" android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.05"/>
<Spinner android:id="@+id/spinnerTechnician" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginBottom="20dp" android:background="@drawable/bg_field_outline" android:paddingStart="16dp" android:paddingEnd="16dp" android:entries="@array/technician_options"/>
<!--  Assign Branch  -->
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="ASSIGN BRANCH" android:textColor="@color/techfix_gray_text" android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.05"/>
<Spinner android:id="@+id/spinnerBranch" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginBottom="24dp" android:background="@drawable/bg_field_outline" android:paddingStart="16dp" android:paddingEnd="16dp" android:entries="@array/branch_options"/>
<Button android:id="@+id/btnConfirmAppointment" android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/bg_button_orange" android:text="Confirm Appointment" android:textAllCaps="false" android:textColor="@color/techfix_white" android:textSize="17sp" android:textStyle="bold"/>
</LinearLayout>
</androidx.core.widget.NestedScrollView>
<!--  ===== Bottom navigation =====  -->
<com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottomNav" android:layout_width="0dp" android:layout_height="wrap_content" android:background="@color/techfix_white" app:itemIconTint="@color/nav_item_color_selector" app:itemTextColor="@color/nav_item_color_selector" app:menu="@menu/menu_admin_bottom_nav" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
