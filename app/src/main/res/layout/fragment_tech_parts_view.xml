<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F2F3F5">
<!--  Header  -->
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#122040" android:padding="20dp" android:gravity="center_horizontal">
<TextView android:id="@+id/txtScreenTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SPARE PARTS" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"/>
</LinearLayout>
<!--  Search  -->
<EditText android:id="@+id/edtSearchParts" android:layout_width="match_parent" android:layout_height="48dp" android:layout_margin="16dp" android:background="@drawable/bg_input_outline" android:paddingStart="16dp" android:paddingEnd="16dp" android:hint="Search parts..." android:textColorHint="#8A93A8" android:textColor="#122040" android:inputType="text"/>
<!--  Parts list  -->
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
<!--  Part 1  -->
<LinearLayout style="@style/PartCard">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:text="OLED Panel" style="@style/PartName"/>
<TextView android:text="Compatible: iPhone 13" style="@style/PartCompat"/>
<TextView android:text="Rs. 18,500" style="@style/PartPrice"/>
</LinearLayout>
<TextView android:text="LOW STOCK · 6 left" style="@style/StockBadgeLow"/>
</LinearLayout>
<!--  Part 2  -->
<LinearLayout style="@style/PartCard">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:text="Battery 4500mAh" style="@style/PartName"/>
<TextView android:text="Compatible: Samsung A54" style="@style/PartCompat"/>
<TextView android:text="Rs. 3,200" style="@style/PartPrice"/>
</LinearLayout>
<TextView android:text="22 in stock" style="@style/StockBadgeOk"/>
</LinearLayout>
<!--  Part 3  -->
<LinearLayout style="@style/PartCard">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:text="Charging Port Flex" style="@style/PartName"/>
<TextView android:text="Compatible: iPhone 12" style="@style/PartCompat"/>
<TextView android:text="Rs. 2,100" style="@style/PartPrice"/>
</LinearLayout>
<TextView android:text="LOW STOCK · 3 left" style="@style/StockBadgeLow"/>
</LinearLayout>
<!--  Part 4  -->
<LinearLayout style="@style/PartCard">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:text="Laptop Keyboard" style="@style/PartName"/>
<TextView android:text="Compatible: Dell Inspiron 15" style="@style/PartCompat"/>
<TextView android:text="Rs. 5,400" style="@style/PartPrice"/>
</LinearLayout>
<TextView android:text="14 in stock" style="@style/StockBadgeOk"/>
</LinearLayout>
<!--  Part 5  -->
<LinearLayout style="@style/PartCard">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:text="Motherboard (Used)" style="@style/PartName"/>
<TextView android:text="Compatible: iPhone 13" style="@style/PartCompat"/>
<TextView android:text="Rs. 24,000" style="@style/PartPrice"/>
</LinearLayout>
<TextView android:text="LOW STOCK · 1 left" style="@style/StockBadgeLow"/>
</LinearLayout>
<Button android:id="@+id/btnRequestPart" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:layout_marginBottom="16dp" android:background="@drawable/bg_button_orange" android:text="REQUEST PART FOR THIS REPAIR" android:textColor="#FFFFFF" android:textStyle="bold"/>
</LinearLayout>
</ScrollView>
<!--  Bottom nav  -->
<include layout="@layout/bottom_nav_bar"/>
</LinearLayout>