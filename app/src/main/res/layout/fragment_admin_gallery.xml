<!--  Screen: Repair Gallery (before/after photo browser)  -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/techfix_bg">
<!--  ===== Header =====  -->
<LinearLayout android:id="@+id/header" android:layout_width="0dp" android:layout_height="wrap_content" android:background="@color/techfix_navy" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="20dp" android:paddingBottom="24dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
<RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:layout_centerVertical="true" android:padding="8dp" android:text="←" android:textColor="@color/techfix_white" android:textSize="22sp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" android:text="Repair Gallery" android:textColor="@color/techfix_white" android:textSize="22sp" android:textStyle="bold"/>
<TextView android:id="@+id/btnAddGalleryItem" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:padding="8dp" android:text="+" android:textColor="@color/techfix_white" android:textSize="26sp"/>
</RelativeLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="Before &amp; After Photo Showcase" android:textColor="#C9CFDA" android:textSize="15sp"/>
</LinearLayout>
<!--  ===== Scrollable content =====  -->
<androidx.core.widget.NestedScrollView android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintTop_toBottomOf="@id/header" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<!--  Category filter tabs  -->
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="18dp" android:orientation="horizontal">
<TextView android:id="@+id/tabAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="14dp" android:background="@drawable/bg_chip_selected_orange" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:text="All" android:textColor="@color/techfix_white" android:textSize="15sp" android:textStyle="bold"/>
<TextView android:id="@+id/tabMobile" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="14dp" android:padding="12dp" android:text="Mobile" android:textColor="@color/techfix_gray_text" android:textSize="15sp"/>
<TextView android:id="@+id/tabLaptop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="14dp" android:padding="12dp" android:text="Laptop" android:textColor="@color/techfix_gray_text" android:textSize="15sp"/>
<TextView android:id="@+id/tabDesktop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="12dp" android:text="Desktop" android:textColor="@color/techfix_gray_text" android:textSize="15sp"/>
</LinearLayout>

<androidx.recyclerview.widget.RecyclerView
    android:id="@+id/rvGallery"
    android:layout_width="match_parent" android:layout_height="wrap_content"/>

</LinearLayout>
</androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
