<!--  Screen: Repair Gallery (before/after photo browser)  -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/techfix_bg">
<!--  ===== Header =====  -->
<LinearLayout android:id="@+id/header" android:layout_width="0dp" android:layout_height="wrap_content" android:background="@color/techfix_navy" android:orientation="vertical" android:paddingTop="24dp" android:paddingBottom="24dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="REPAIR GALLERY" android:textColor="@color/techfix_white" android:textSize="22sp" android:textStyle="bold" android:letterSpacing="0.03"/>
</LinearLayout>
<!--  ===== Scrollable content =====  -->
<androidx.core.widget.NestedScrollView android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintTop_toBottomOf="@id/header" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<!--  Category filter tabs  -->
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="18dp" android:orientation="horizontal">
<TextView android:id="@+id/tabAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="14dp" android:background="@drawable/bg_chip_selected_orange" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:text="All" android:textColor="@color/techfix_white" android:textSize="15sp" android:textStyle="bold"/>
<TextView android:id="@+id/tabMobile" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="14dp" android:padding="12dp" android:text="Mobile" android:textColor="@color/techfix_gray_text" android:textSize="15sp"/>
<TextView android:id="@+id/tabLaptop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="14dp" android:padding="12dp" android:text="Laptop" android:textColor="@color/techfix_gray_text" android:textSize="15sp"/>
<TextView android:id="@+id/tabDesktop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="12dp" android:text="Desktop" android:textColor="@color/techfix_gray_text" android:textSize="15sp"/>
</LinearLayout>
<!--  Gallery grid: 2 columns.
                 NOTE: replace this with a RecyclerView (id: rvGallery) using
                 a GridLayoutManager(spanCount = 2), bound to a
                 RepairGalleryAdapter that loads before/after image pairs
                 from Firebase Storage per repair.  -->
<GridLayout android:id="@+id/galleryGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2">
<!--  Item: Screen Replacement  -->
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:orientation="vertical">
<androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/techfix_white" app:cardCornerRadius="16dp" app:cardElevation="0dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
<TextView android:layout_width="match_parent" android:layout_height="140dp" android:background="@drawable/bg_thumb_placeholder" android:gravity="center" android:text="BEFORE / AFTER" android:textColor="@color/techfix_gray_text" android:textSize="12sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Screen Replacement" android:textColor="@color/techfix_navy" android:textSize="15sp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Samsung Galaxy A54" android:textColor="@color/techfix_gray_text" android:textSize="13sp"/>
</LinearLayout>
</androidx.cardview.widget.CardView>
</LinearLayout>
<!--  Item: Battery Service  -->
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:orientation="vertical">
<androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/techfix_white" app:cardCornerRadius="16dp" app:cardElevation="0dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
<TextView android:layout_width="match_parent" android:layout_height="140dp" android:background="@drawable/bg_thumb_placeholder" android:gravity="center" android:text="BEFORE / AFTER" android:textColor="@color/techfix_gray_text" android:textSize="12sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Battery Service" android:textColor="@color/techfix_navy" android:textSize="15sp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="iPhone 12" android:textColor="@color/techfix_gray_text" android:textSize="13sp"/>
</LinearLayout>
</androidx.cardview.widget.CardView>
</LinearLayout>
<!--  Item: Water Damage Fix  -->
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:orientation="vertical">
<androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/techfix_white" app:cardCornerRadius="16dp" app:cardElevation="0dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
<TextView android:layout_width="match_parent" android:layout_height="140dp" android:background="@drawable/bg_thumb_placeholder" android:gravity="center" android:text="BEFORE / AFTER" android:textColor="@color/techfix_gray_text" android:textSize="12sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Water Damage Fix" android:textColor="@color/techfix_navy" android:textSize="15sp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="iPhone 13" android:textColor="@color/techfix_gray_text" android:textSize="13sp"/>
</LinearLayout>
</androidx.cardview.widget.CardView>
</LinearLayout>
<!--  Item: Keyboard Repair  -->
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:orientation="vertical">
<androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/techfix_white" app:cardCornerRadius="16dp" app:cardElevation="0dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
<TextView android:layout_width="match_parent" android:layout_height="140dp" android:background="@drawable/bg_thumb_placeholder" android:gravity="center" android:text="BEFORE / AFTER" android:textColor="@color/techfix_gray_text" android:textSize="12sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Keyboard Repair" android:textColor="@color/techfix_navy" android:textSize="15sp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Dell Inspiron 15" android:textColor="@color/techfix_gray_text" android:textSize="13sp"/>
</LinearLayout>
</androidx.cardview.widget.CardView>
</LinearLayout>
<!--  Item: Motherboard Diagnosis  -->
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:orientation="vertical">
<androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/techfix_white" app:cardCornerRadius="16dp" app:cardElevation="0dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
<TextView android:layout_width="match_parent" android:layout_height="140dp" android:background="@drawable/bg_thumb_placeholder" android:gravity="center" android:text="BEFORE / AFTER" android:textColor="@color/techfix_gray_text" android:textSize="12sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Motherboard Diagnosis" android:textColor="@color/techfix_navy" android:textSize="15sp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MacBook Pro 13" android:textColor="@color/techfix_gray_text" android:textSize="13sp"/>
</LinearLayout>
</androidx.cardview.widget.CardView>
</LinearLayout>
<!--  Item: Charging Port  -->
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:orientation="vertical">
<androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/techfix_white" app:cardCornerRadius="16dp" app:cardElevation="0dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
<TextView android:layout_width="match_parent" android:layout_height="140dp" android:background="@drawable/bg_thumb_placeholder" android:gravity="center" android:text="BEFORE / AFTER" android:textColor="@color/techfix_gray_text" android:textSize="12sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Charging Port" android:textColor="@color/techfix_navy" android:textSize="15sp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OnePlus Nord" android:textColor="@color/techfix_gray_text" android:textSize="13sp"/>
</LinearLayout>
</androidx.cardview.widget.CardView>
</LinearLayout>
</GridLayout>
</LinearLayout>
</androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
