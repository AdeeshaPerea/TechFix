<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F2F3F5">
<!--  Header  -->
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#122040" android:padding="20dp" android:gravity="center_horizontal">
<TextView android:id="@+id/txtScreenTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MY SCHEDULE" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"/>
<TextView android:id="@+id/txtTechBranch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Nuwan Silva · Colombo 03" android:textColor="#AEB6C4" android:textSize="14sp"/>
</LinearLayout>
<!--  Day selector  -->
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="16dp" android:paddingBottom="8dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:weightSum="6">
<LinearLayout style="@style/DayCellUnselected" android:layout_weight="1">
<TextView style="@style/DayLabel" android:text="MON"/>
<TextView style="@style/DayNumber" android:text="17"/>
</LinearLayout>
<LinearLayout style="@style/DayCellUnselected" android:layout_weight="1">
<TextView style="@style/DayLabel" android:text="TUE"/>
<TextView style="@style/DayNumber" android:text="18"/>
</LinearLayout>
<LinearLayout style="@style/DayCellUnselected" android:layout_weight="1">
<TextView style="@style/DayLabel" android:text="WED"/>
<TextView style="@style/DayNumber" android:text="19"/>
</LinearLayout>
<LinearLayout style="@style/DayCellUnselected" android:layout_weight="1">
<TextView style="@style/DayLabel" android:text="THU"/>
<TextView style="@style/DayNumber" android:text="20"/>
</LinearLayout>
<LinearLayout android:id="@+id/dayCellSelected" style="@style/DayCellSelected" android:layout_weight="1">
<TextView style="@style/DayLabelSelected" android:text="FRI"/>
<TextView style="@style/DayNumberSelected" android:text="21"/>
</LinearLayout>
<LinearLayout style="@style/DayCellUnselected" android:layout_weight="1">
<TextView style="@style/DayLabel" android:text="SAT"/>
<TextView style="@style/DayNumber" android:text="22"/>
</LinearLayout>
</LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="16dp" android:text="TODAY · 4 JOBS" android:textColor="#8A93A8" android:textStyle="bold" android:textSize="13sp"/>
<!--  Schedule list  -->
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<!--  Job 1  -->
<LinearLayout style="@style/ScheduleCard">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:text="9:00 AM" style="@style/ScheduleTime"/>
<TextView android:text="Screen Replacement" style="@style/ScheduleJobTitle"/>
<TextView android:text="Samsung Galaxy A54" style="@style/ScheduleJobSubtitle"/>
</LinearLayout>
<TextView android:text="In Progress" style="@style/StatusBadgeInProgress"/>
</LinearLayout>
<!--  Job 2  -->
<LinearLayout style="@style/ScheduleCard">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:text="11:30 AM" style="@style/ScheduleTime"/>
<TextView android:text="Battery Service" style="@style/ScheduleJobTitle"/>
<TextView android:text="iPhone 12" style="@style/ScheduleJobSubtitle"/>
</LinearLayout>
<TextView android:text="Pending" style="@style/StatusBadgePending"/>
</LinearLayout>
<!--  Job 3  -->
<LinearLayout style="@style/ScheduleCard">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:text="1:30 PM" style="@style/ScheduleTime"/>
<TextView android:text="Motherboard Diagnosis" style="@style/ScheduleJobTitle"/>
<TextView android:text="Dell Inspiron 15" style="@style/ScheduleJobSubtitle"/>
</LinearLayout>
<TextView android:text="Pending" style="@style/StatusBadgePending"/>
</LinearLayout>
<!--  Job 4  -->
<LinearLayout style="@style/ScheduleCard">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:text="4:00 PM" style="@style/ScheduleTime"/>
<TextView android:text="Water Damage Fix" style="@style/ScheduleJobTitle"/>
<TextView android:text="iPhone 13" style="@style/ScheduleJobSubtitle"/>
</LinearLayout>
<TextView android:text="Scheduled" style="@style/StatusBadgeScheduled"/>
</LinearLayout>
</LinearLayout>
</ScrollView>
<!--  Bottom nav  -->
<include layout="@layout/bottom_nav_bar"/>
</LinearLayout>