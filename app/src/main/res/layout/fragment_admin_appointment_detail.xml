<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android" 
    xmlns:app="http://schemas.android.com/apk/res-auto" 
    android:layout_width="match_parent" 
    android:layout_height="match_parent" 
    android:orientation="vertical" 
    android:background="@color/techfix_bg">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/techfix_navy"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp">

        <RelativeLayout 
            android:layout_width="match_parent" 
            android:layout_height="wrap_content">

            <ImageButton 
                android:id="@+id/btnBack" 
                android:layout_width="40dp" 
                android:layout_height="40dp" 
                android:layout_alignParentStart="true" 
                android:layout_centerVertical="true" 
                android:background="@drawable/bg_icon_button_navy" 
                android:src="@drawable/ic_arrow_back" 
                android:contentDescription="Back"
                app:tint="@color/techfix_white"/>

            <LinearLayout 
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content" 
                android:layout_centerInParent="true" 
                android:orientation="vertical" 
                android:gravity="center_horizontal">

                <TextView 
                    android:id="@+id/tvAptCode" 
                    android:layout_width="wrap_content" 
                    android:layout_height="wrap_content" 
                    android:text="#RF-1024" 
                    android:textColor="@color/techfix_white" 
                    android:textSize="20sp" 
                    android:textStyle="bold"/>

                <TextView 
                    android:id="@+id/tvAptStatusBadge" 
                    android:layout_width="wrap_content" 
                    android:layout_height="wrap_content" 
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_pill_orange_solid"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="4dp"
                    android:text="IN PROGRESS" 
                    android:textColor="@color/techfix_white" 
                    android:textSize="11sp" 
                    android:textStyle="bold"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <ScrollView 
        android:layout_width="match_parent" 
        android:layout_height="0dp" 
        android:layout_weight="1">

        <LinearLayout 
            android:layout_width="match_parent" 
            android:layout_height="wrap_content" 
            android:orientation="vertical" 
            android:padding="16dp">

            <!-- Device Information Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/techfix_white"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.05"
                        android:text="DEVICE DETAILS"
                        android:textColor="@color/techfix_gray_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAptDevice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="iPhone 14 Pro"
                        android:textColor="@color/techfix_navy"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAptService"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Service: Screen Replacement"
                        android:textColor="@color/techfix_dark_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvAptProblem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Issue: Display flicker and touch unresponsive."
                        android:textColor="@color/techfix_gray_text"
                        android:textSize="13sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Customer & Technician Assignment Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/techfix_white"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.05"
                        android:text="CUSTOMER &amp; ASSIGNMENT"
                        android:textColor="@color/techfix_gray_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAptCustomer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="👤 Customer: Dilani Fernando (0771234567)"
                        android:textColor="@color/techfix_navy"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAptBranchTech"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="📍 Branch: TechFix Colombo • Tech: Nuwan Silva"
                        android:textColor="@color/techfix_dark_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvAptDateTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="🕒 Requested: Aug 24, 2026 at 10:00 AM"
                        android:textColor="@color/techfix_gray_text"
                        android:textSize="13sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Vertical Repair Timeline Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/techfix_white"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.05"
                        android:text="REPAIR TIMELINE"
                        android:textColor="@color/techfix_gray_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Timeline Step 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● "
                            android:textColor="#059669"
                            android:textSize="16sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Repair Created &amp; Confirmed"
                            android:textColor="@color/techfix_navy"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Connector Line -->
                    <View
                        android:layout_width="2dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="5dp"
                        android:background="#059669" />

                    <!-- Timeline Step 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● "
                            android:textColor="#059669"
                            android:textSize="16sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Device Received at Branch"
                            android:textColor="@color/techfix_navy"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Connector Line -->
                    <View
                        android:layout_width="2dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="5dp"
                        android:background="@color/techfix_orange" />

                    <!-- Timeline Step 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● "
                            android:textColor="@color/techfix_orange"
                            android:textSize="16sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Technician Assigned &amp; Diagnosis"
                            android:textColor="@color/techfix_navy"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Connector Line -->
                    <View
                        android:layout_width="2dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="5dp"
                        android:background="@color/techfix_light_gray" />

                    <!-- Timeline Step 4 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="○ "
                            android:textColor="@color/techfix_gray_text"
                            android:textSize="16sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Repair Completed &amp; QC Passed"
                            android:textColor="@color/techfix_gray_text"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Repair Photos Main Action Button -->
            <Button 
                android:id="@+id/btnViewRepairPhotos" 
                android:layout_width="match_parent" 
                android:layout_height="52dp" 
                android:background="@drawable/bg_button_navy" 
                android:text="📸 VIEW REPAIR PHOTOS" 
                android:textColor="@color/techfix_white" 
                android:textSize="14sp"
                android:textStyle="bold"/>

            <!-- Status & Management Action Buttons -->
            <LinearLayout 
                android:layout_width="match_parent" 
                android:layout_height="wrap_content" 
                android:orientation="horizontal" 
                android:layout_marginTop="12dp">

                <Button 
                    android:id="@+id/btnAcceptApt" 
                    android:layout_width="0dp" 
                    android:layout_height="48dp" 
                    android:layout_weight="1" 
                    android:layout_marginEnd="6dp" 
                    android:background="@drawable/bg_button_orange" 
                    android:text="ACCEPT" 
                    android:textColor="@color/techfix_white" 
                    android:textStyle="bold"/>

                <Button 
                    android:id="@+id/btnRejectApt" 
                    android:layout_width="0dp" 
                    android:layout_height="48dp" 
                    android:layout_weight="1" 
                    android:layout_marginStart="6dp" 
                    android:background="@drawable/bg_button_outline" 
                    android:text="REJECT" 
                    android:textColor="@color/techfix_navy" 
                    android:textStyle="bold"/>
            </LinearLayout>

            <Button 
                android:id="@+id/btnAssignTechnician" 
                android:layout_width="match_parent" 
                android:layout_height="48dp" 
                android:layout_marginTop="10dp" 
                android:background="@drawable/bg_button_white_card" 
                android:text="ASSIGN TECHNICIAN" 
                android:textColor="@color/techfix_navy" 
                android:textStyle="bold"/>

            <Button 
                android:id="@+id/btnChangeBranch" 
                android:layout_width="match_parent" 
                android:layout_height="48dp" 
                android:layout_marginTop="10dp" 
                android:background="@drawable/bg_button_white_card" 
                android:text="CHANGE BRANCH" 
                android:textColor="@color/techfix_navy" 
                android:textStyle="bold"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
