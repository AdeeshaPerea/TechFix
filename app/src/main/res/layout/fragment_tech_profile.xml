<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F2F3F5">
<!--  Header  -->
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#122040" android:padding="20dp" android:gravity="center_horizontal">
<TextView android:id="@+id/txtScreenTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MY PROFILE" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"/>
</LinearLayout>
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:gravity="center_horizontal">
<!--  Avatar  -->
<TextView android:id="@+id/txtAvatarInitials" android:layout_width="90dp" android:layout_height="90dp" android:background="@drawable/bg_avatar_circle" android:gravity="center" android:text="NS" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold"/>
<TextView android:id="@+id/txtTechName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Nuwan Silva" android:textColor="#122040" android:textSize="22sp" android:textStyle="bold"/>
<TextView android:id="@+id/txtTechRole" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mobile Repair Specialist · Colombo 03" android:textColor="#8A93A8" android:textSize="14sp"/>
<!--  Stats row  -->
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="20dp" android:weightSum="3">
<LinearLayout style="@style/StatCard" android:layout_weight="1">
<TextView android:text="128" style="@style/StatNumber"/>
<TextView android:text="Repairs Done" style="@style/StatLabel"/>
</LinearLayout>
<LinearLayout style="@style/StatCard" android:layout_weight="1" android:layout_marginStart="8dp">
<TextView android:text="6" style="@style/StatNumber"/>
<TextView android:text="Active Jobs" style="@style/StatLabel"/>
</LinearLayout>
<LinearLayout style="@style/StatCard" android:layout_weight="1" android:layout_marginStart="8dp">
<TextView android:text="4.9" style="@style/StatNumber"/>
<TextView android:text="Avg Rating" style="@style/StatLabel"/>
</LinearLayout>
</LinearLayout>
<!--  Skills  -->
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="SKILLS & SPECIALIZATION" android:textColor="#8A93A8" android:textStyle="bold" android:textSize="12sp"/>
<com.google.android.flexbox.FlexboxLayout xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:flexWrap="wrap">
<TextView style="@style/SkillChip" android:text="Screen Repair"/>
<TextView style="@style/SkillChip" android:text="Battery Service"/>
<TextView style="@style/SkillChip" android:text="Motherboard"/>
<TextView style="@style/SkillChip" android:text="Water Damage"/>
</com.google.android.flexbox.FlexboxLayout>
<!--  Menu options  -->
<TextView android:id="@+id/menuEditProfile" style="@style/ProfileMenuRow" android:text="Edit Profile" android:layout_marginTop="20dp"/>
<TextView android:id="@+id/menuAvailability" style="@style/ProfileMenuRow" android:text="Availability"/>
<TextView android:id="@+id/menuNotifications" style="@style/ProfileMenuRow" android:text="Notification Settings"/>
<TextView android:id="@+id/menuChangePassword" style="@style/ProfileMenuRow" android:text="Change Password"/>
<Button android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:background="@drawable/bg_button_outline_orange" android:text="LOG OUT" android:textColor="#F5A623" android:textStyle="bold"/>
</LinearLayout>
</ScrollView>
<!--  Bottom nav  -->
<include layout="@layout/bottom_nav_bar"/>
</LinearLayout>