<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1.2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvPartName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/tvStockStatusBadge"
                android:layout_marginEnd="8dp"
                android:text="Samsung A54 Display Assembly"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/tvStockStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="AVAILABLE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#065F46"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="#D1FAE5"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvPartCategoryAndModel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Mobile Display  •  Samsung Galaxy A54"
            android:textSize="13sp"
            android:textColor="#64748B" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvPartQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Stock: 4 Units (Min: 2)"
                android:textSize="13sp"
                android:textColor="#475569" />

            <TextView
                android:id="@+id/tvPartPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Rs. 25,000"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#059669" />
        </RelativeLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
