<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvPartName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Samsung A54 Display Assembly"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/tvAvailabilityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="AVAILABLE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#065F46"
                android:background="#D1FAE5"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvCategoryAndDevice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Category: Mobile Display • Compatible: Samsung A54"
            android:textSize="12sp"
            android:textColor="#64748B" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvStockQuantity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stock: 4 units (Min: 2)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#334155" />

            <TextView
                android:id="@+id/tvUnitPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rs. 25,000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0284C7" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
