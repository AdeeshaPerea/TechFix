<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <ImageView
        android:id="@+id/imgFullPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="Full Screen Repair Photo" />

    <!-- Top Overlay Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#CC0F172A"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnClosePreview"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Close Preview"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btnClosePreview"
            android:layout_marginStart="16dp"
            android:orientation="vertical"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/txtPreviewType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BEFORE REPAIR"
                android:textColor="#38BDF8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPreviewUploader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Uploaded by: Customer"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtPreviewDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aug 23, 2026 · 10:30 AM"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />
        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>
