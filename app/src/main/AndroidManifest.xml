<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TechFix">

        <!-- Role Selection Landing -->
        <activity
            android:name=".ui.main.RoleSelectActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Customer Portal Activities -->
        <activity
            android:name=".customer.CustomerHomeActivity"
            android:exported="false" />
        <activity
            android:name=".customer.SignUpActivity"
            android:exported="false" />
        <activity
            android:name=".customer.NewRepairRequestActivity"
            android:exported="false" />

        <!-- Main Activity Container (Fallback) -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Technician Portal Activities -->
        <activity
            android:name=".ui.tech.TechLoginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.tech.TechRepairsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.tech.TechRepairDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.tech.TechRepairNotesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.tech.TechRepairGalleryActivity"
            android:exported="false" />
        <activity
            android:name=".ui.tech.TechProfileActivity"
            android:exported="false" />

        <!-- Admin Portal Activities -->
        <activity
            android:name=".ui.admin.AdminLoginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.AdminDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.AdminAppointmentsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.AdminAppointmentDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.AdminBranchesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.AdminTechniciansActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.AdminSparePartsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.AdminServicesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.AdminProfileSettingsActivity"
            android:exported="false" />

    </application>

</manifest>